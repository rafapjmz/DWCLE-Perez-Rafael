        HospitalController o-- ListView
    }
    package models {
        abstract class Patient {
            - _name: string
            - _dni: string 
            - _surname: string 
            + get name(): string
            + set name(value: string): void
        }

        class ForeignPatient extends Patient {
        }

        class RetiredPatient extends Patient {}
        class DefaultPatient extends Patient {}
       

        class Hospital {
            - patients: Map<UUID, Patient>
            + add(patient: Patient): Patient
            + remove(uuid: UUID): void
            + update(uuid: UUID, patient: Patient): Patient
            + findById(uuid: UUID): Patient
            + findAll(): List<Patient>
            + findAllRetired(): List<Patient>
            + findAllForeign(): List<Patient>
        }


        Hospital "1" o-- "0..*" Patient : patients
        HospitalService "1" o- "0..*" Hospital : hospital
 
        
