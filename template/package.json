{
  "name": "dwcle-template",
  "version": "2.0.0",
  "description": "Plantilla base de DWCLE: TypeScript + Vite con calidad de código integrada (ESLint, Prettier, Vitest, Husky, Commitlint)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start:dev": "npm run dev",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "api": "json-server src/assets/mocks/db.json --port 3000",
    "start:api": "npm run api",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "uml": "docker run --rm -v \"$PWD/doc/uml:/data\" plantuml/plantuml -tpng \"/data/*.puml\"",
    "sonar:scan": "cd apps/sonarqube && npm run sonar:scan",
    "prepare": "husky || echo 'husky: no hay .git en esta carpeta, los hooks se instalan cuando el proyecto es la raíz del repositorio'"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "json-server": "^1.0.0-beta.15",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
